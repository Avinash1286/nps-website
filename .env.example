# Public Next.js configuration. `npx convex dev` writes the Convex values.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_CONVEX_URL=https://your-deployment.convex.cloud
CONVEX_DEPLOYMENT=dev:your-deployment

# Clerk staff authentication. Configure the Clerk JWT template named `convex`.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_replace_me
CLERK_SECRET_KEY=sk_test_replace_me
# Optional: only set this when Clerk is configured with a custom Frontend API domain.
NEXT_PUBLIC_CLERK_FAPI=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/admin

# Shared only between the Next.js server and Convex. Generate at least 32 random bytes.
ASSISTANT_SERVICE_SECRET=replace_with_a_long_random_secret
REQUEST_FINGERPRINT_SECRET=replace_with_another_long_random_secret
FORM_SERVICE_SECRET=replace_with_a_third_long_random_secret

# Optional bot protection for public forms.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Set the following with `npx convex env set KEY VALUE`, not in browser code:
# CLERK_JWT_ISSUER_DOMAIN=https://your-clerk-domain.clerk.accounts.dev
# INITIAL_ADMIN_CLERK_USER_ID=user_replace_with_the_designated_admin_id
# SEED_SECRET=another_long_random_secret
# GEMINI_API_KEY=your_google_ai_authorization_key
# GEMINI_MODEL=gemini-3.6-flash
# ASSISTANT_SERVICE_SECRET=the_same_long_random_secret
# FORM_SERVICE_SECRET=the_same_form_secret_used_by_next
# NOTIFICATION_WEBHOOK_URL=https://notifications.your-domain.example/nps
# NOTIFICATION_WEBHOOK_SECRET=another_long_random_secret
# NOTIFICATION_WEBHOOK_ALLOWED_HOSTS=notifications.your-domain.example
# AUDIT_RETENTION_DAYS=730
# WORKFLOW_RETENTION_DAYS=1095
# ADMISSION_RETENTION_DAYS=2555
# NEWSLETTER_SUPPRESSION_RETENTION_DAYS=1095
# JOB_RETENTION_DAYS=90
